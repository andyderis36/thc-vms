# ============================================================
# THC-VMS production secrets — ONE file for the whole VPS stack.
# Usage on the VPS (never commit this file):
#   cp .env.prod.example .env   # repo root, then fill every CHANGEME
#   docker compose -f docker-compose.prod.yml up -d --build
# Compose auto-loads repo-root `.env` for ${VAR} interpolation below,
# and the backend/migrate services read the same file via env_file.
# Docs: docs/DEPLOY_PROD.md (JWT, rate limit, DB/S3 rotation).
# ============================================================

# --- Infra secrets (no defaults in prod compose — compose fails loud) ---
POSTGRES_USER=thc_user
POSTGRES_PASSWORD=CHANGEME-min-16-acak
POSTGRES_DB=thc_vms_db
MINIO_ROOT_USER=CHANGEME-minio-user
MINIO_ROOT_PASSWORD=CHANGEME-min-16-acak
# Image MinIO di VPS. Repo minio/minio di Docker Hub sudah dihapus, jadi tag
# minio/minio:latest tidak bisa di-pull lagi. Default di bawah menunjuk image
# yang identik byte-per-byte dengan minio/minio:latest (digest sama), hanya
# disimpan di ghcr.io. Naikkan versinya lewat key ini bila perlu.
MINIO_IMAGE=ghcr.io/netvark/minio@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e

# --- Backend (mirrors backend/.env.example; prod values) ---
APP_NAME=THC-VMS-Backend
APP_ENV=production
APP_PORT=8080
APP_DEBUG=false
DB_HOST=postgres
DB_PORT=5432
DB_USER=thc_user
DB_PASSWORD=CHANGEME-sama-dengan-POSTGRES_PASSWORD
DB_NAME=thc_vms_db
DB_SSLMODE=disable
JWT_SECRET=CHANGEME-hasil-openssl-rand-hex-32
JWT_EXPIRATION_HOURS=24
# Produksi WAJIB 5 — jangan -1 (limiter mati) di production.
AUTH_RATE_LIMIT=5
AUTH_RATE_WINDOW=1m
# Origin publik FE, koma-dipisah. Wajib diisi (tanpa BFF, FE->BE cross-origin).
CORS_ALLOWED_ORIGINS=https://vms.thc.contoh
# Proxy terpercaya (Caddy): IP/CIDR privat Caddy di VPS, koma-dipisah
# (mis. 10.0.0.5 atau 10.0.0.0/24) agar ClientIP memakai X-Forwarded-For dan
# bucket limiter per-IP kembali per-klien. Kosong = hanya RemoteAddr (XFF diabaikan).
TRUSTED_PROXIES=CHANGEME-ip-atau-cidr-caddy-contoh-10-0-0-0-24
# Storage produksi (S3/R2 asli atau MinIO internal compose di bawah).
STORAGE_DRIVER=minio
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY_ID=CHANGEME-sama-dengan-MINIO_ROOT_USER
S3_SECRET_ACCESS_KEY=CHANGEME-sama-dengan-MINIO_ROOT_PASSWORD
S3_BUCKET_NAME=thc-vms-bucket
S3_USE_SSL=false
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=https://s3.thc.contoh/thc-vms-bucket
S3_PRESIGN_TTL_MINUTES=15
MAX_UPLOAD_SIZE_MB=5
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png
# Auto-rule sweep period (default 15m bila kosong). WAJIB <= 45m agar window
# reminder R4 tidak terlewat; interval > ReminderWindow memicu warning saat boot.
WORKER_INTERVAL=15m
# Mail / SMTP produksi (opsional, default mati — sama seperti lokal).
# Aktifkan hanya bila notifikasi email dibutuhkan: SMTP_ENABLED=true +
# SMTP_HOST/SMTP_USER/SMTP_PASSWORD dari secret manager. Kredensial asli
# HANYA hidup di file `.env` VPS (tidak pernah di repo ini).
# Port 465 = implicit SSL (default, mis. Hostinger smtp.hostinger.com);
# port 587 = STARTTLS. SMTP_FROM kosong = pengirim memakai SMTP_USER
# (fallback di mail adapter, bukan config).
# Nilai di bawah ini placeholder — JANGAN commit file `.env` asli,
# dan JANGAN pernah log password.
SMTP_ENABLED=false
SMTP_HOST=CHANGEME-smtp-host-contoh
SMTP_PORT=465
SMTP_USER=CHANGEME-smtp-user-contoh
SMTP_PASSWORD=CHANGEME-min-16-acak
SMTP_FROM=
SMTP_FROM_NAME=THC VMS
SMTP_TIMEOUT=30s

# --- Frontend build args (NEXT_PUBLIC_* dibakar saat build!) ---
NEXT_PUBLIC_API_BASE_URL=https://api.thc.contoh/api/v1
NEXT_PUBLIC_STORAGE_BASE_URL=https://s3.thc.contoh/thc-vms-bucket
NEXT_PUBLIC_APP_NAME=THC Visitor Management System

# --- Origin publik frontend (WAJIB bila email aktif) ---
# Dipakai backend untuk membangun link verifikasi email (/verify-email).
# Tanpa ini backend memakai default http://localhost:3210 sehingga link di
# email produksi mati. Isi dengan origin publik yang sama dengan SITE_ADDRESS.
FRONTEND_BASE_URL=https://vms.thc.contoh

# --- Bootstrap database kosong (opsional) ---
# 1 = deploy.sh boleh menjalankan seed SATU KALI saat database benar-benar kosong
# (tabel role belum berisi data). Nilai selain 1 = seed tidak pernah jalan.
# WAJIB 0 di produksi nyata: seed membuat akun demo dengan password demo dan
# me-reset passwordnya bila dijalankan ulang.
BOOTSTRAP_SEED=0

# --- Reverse proxy / TLS (opsional) ---
# Kosong = catch-all HTTP ":80" (cocok untuk akses LAN via IP, tanpa TLS).
# Isi domain (mis. vms.thc.co.id) -> Caddy aktifkan TLS otomatis (ACME) +
# redirect HTTP->HTTPS. Syarat: DNS A/AAAA -> IP publik VPS, port 80 & 443
# terbuka ke internet. Tanpa IP publik, biarkan kosong (HTTP-01 tak akan lolos).
# Bila diisi, samakan dengan CORS_ALLOWED_ORIGINS & NEXT_PUBLIC_* di atas.
# CATATAN: nilai kosong di sini aman. Compose menormalkannya jadi ":80".
# Yang berbahaya adalah env Caddy yang di-set string kosong tanpa default.
SITE_ADDRESS=
