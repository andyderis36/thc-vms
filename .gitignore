# OpenCode agent tooling (session state + plan drafts) — lokal saja, bukan
# source aplikasi. `plans/*.md` adalah catatan kerja agent, bukan SSOT produk.
.omo/

# Catatan & catatan QA pribadi — lokal saja, tidak pernah di-commit.
# Sebagian pernah ikut ter-track di commit lama, lalu di-untrack dari index.
thc-notepad.txt
vms-notepad.txt
vms-user-feedback.txt
user-feedback.txt

# Local runtime state written by vms.ps1 (pids, logs, the compiled server).
.runtime/

# Local secrets. .env.example is committed; .env is never.
backend/.env
frontend/.env.local
# Production secrets (docker-compose.prod.yml reads repo-root .env).
/.env
.env.prod.local

# Playwright MCP scratch artifacts (console logs + traces)
.playwright-mcp/

# QA run outputs (logs, screenshots) — local only, never commit.
*.log
qa-evidence/
frontend/screenshots/
docs/stitch-ui/*.png

# Local QA upload fixtures (KTP/selfie/SPK samples) — never commit.
dummy-assets/

# Stray Node artifacts at repo root (the apps live in frontend/).
node_modules/
.vite/
thc-vms-acc.pdf
