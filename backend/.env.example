# ============================================================
# THC Visitor Management System (VMS) - Backend Environment
# Salin file ini menjadi `.env` dan sesuaikan untuk lingkungan Anda.
# Nama variabel mengikuti docs/5. LOCAL_DEV.md bagian 4.1.
# Nilai pool database memakai baseline laptop-safe (S4); lihat komentar di
# bagian Database Connection untuk rekomendasi VPS produksi.
# ============================================================

# --- App Configuration ---
APP_NAME=THC-VMS-Backend
APP_ENV=local
APP_PORT=8080
APP_DEBUG=true
# Asal web publik (Next.js) yang ditautkan email verifikasi ganti email:
# tautan konfirmasi berbentuk {FRONTEND_BASE_URL}/verify-email?token=...
# Local dev default http://localhost:3210 bila dikosongkan.
FRONTEND_BASE_URL=http://localhost:3210

# --- Database Connection (pgxpool) ---
# Baseline aman untuk laptop/dev: MaxConns=10, MinConns=0, MinIdleConns=1 —
# cukup untuk beban MVP dan tidak menghabiskan max_connections PostgreSQL lokal.
# Rekomendasi VPS produksi (beban lebih tinggi, bukan laptop): naikkan ke
# MaxConns=15 dan MinConns=2 (biarkan MinIdleConns=1-2), mis. lewat override
# environment produksi alih-alih mengubah file ini.
DB_HOST=localhost
DB_PORT=5432
DB_USER=thc_user
DB_PASSWORD=thc_password_local
DB_NAME=thc_vms_db
DB_SSLMODE=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_MIN_IDLE_CONNS=1
# Umur koneksi hidup + jitter (mengacak waktu daur-ulang agar tak serempak).
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_LIFETIME_JITTER=5m
# Koneksi menganggur dipangkas setelah durasi ini.
DB_MAX_CONN_IDLE_TIME=10m
# USANG (deprecated): pgx v5 tidak punya acquire-timeout tingkat pool; lama
# menunggu koneksi bebas dibatasi oleh context per-request, dan dial timeout
# memakai nilai tetap 5s di kode. Kunci ini tetap diterima demi kompatibilitas
# `.env` lama, tetapi TIDAK lagi dipakai sebagai dial timeout.
DB_ACQUIRE_TIMEOUT=5s

# --- Authentication (JWT) ---
# WAJIB diisi. Backend menolak start bila kosong (tidak ada default aman).
# Nilai di bawah ini hanya contoh lokal yang JELAS PALSU — WAJIB diganti di
# production dengan string acak min. 32 karakter (mis. hasil `openssl rand -hex 32`).
JWT_SECRET=thc-super-secret-key-2026-mvp-token-signature
JWT_EXPIRATION_HOURS=24

# --- Login Anti-Bruteforce ---
# Batas upaya POST /auth/login per IP per jendela waktu.
# PERHATIAN: -1 = limiter DIMATIKAN (mode open, khusus local dev/QA saja).
# JANGAN pakai -1 di production! Produksi WAJIB 5 (default aman di bawah).
# APP_ENV=production + AUTH_RATE_LIMIT=-1 = backend GAGAL START (fail-fast, tidak pernah -1 di production).
# Dev yang butuh login tanpa batas cukup set -1 di file `.env` lokalnya
# (gitignored) — jangan ubah default file ini.
AUTH_RATE_LIMIT=5
AUTH_RATE_WINDOW=1m

# --- CORS Tambahan (tunnel Cloudflare untuk demo remote) ---
# Daftar origin yang diizinkan selain default localhost:3210, koma-dipisah.
# Isi dengan URL tunnel FE (mis. https://xxx.trycloudflare.com) lalu restart BE.
# Kosongkan bila tak butuh akses remote.
CORS_ALLOWED_ORIGINS=

# --- Reverse Proxy Terpercaya (Caddy) ---
# Daftar origin proxy (IP / CIDR, koma-dipisah) yang header
# X-Forwarded-For / X-Real-IP-nya boleh dipakai ClientIP — WAJIB diisi di
# production agar bucket limiter per-IP (login/register/ganti-email) kembali
# per-klien, bukan per-alamat proxy. Isi dengan IP/CIDR privat Caddy di VPS
# (mis. 10.0.0.5 atau 10.0.0.0/24); kosong = tidak percaya proxy mana pun
# (ClientIP = RemoteAddr, XFF palsu diabaikan — default aman untuk dev lokal).
TRUSTED_PROXIES=

# --- S3 / MinIO Object Storage ---
# Kredensial di bawah ini HANYA untuk MinIO lokal via docker compose.
# WAJIB diganti (rotate) di production: isi dari secret manager / env server
# dengan kredensial S3/R2 asli, jangan pakai minioadmin.
STORAGE_DRIVER=minio
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=thc-vms-bucket
S3_USE_SSL=false
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=http://localhost:9000/thc-vms-bucket
# Masa berlaku URL bertanda tangan (presigned) untuk berkas pada respons
# GET /visits (menit). Bucket tetap privat; FE memakai URL singkat ini.
S3_PRESIGN_TTL_MINUTES=15

# --- File Upload Limits ---
MAX_UPLOAD_SIZE_MB=5
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png

# --- Auto-Rule Worker ---
# Periode sapuan aturan otomatis (cancel requested terlewat, flag overstay).
# Format durasi Go ("30m", "1h"). Kosong/rusak = default 1 jam.
WORKER_INTERVAL=30m

# --- Mail / SMTP (opsional, default mati) ---
# SMTP_ENABLED=false = mailer nonaktif; tidak ada koneksi dial apa pun.
# Set true + isi SMTP_HOST untuk mengaktifkan (fail-fast saat boot bila
# HOST kosong). Hanya placeholder palsu di file ini — JANGAN commit file
# `.env` asli ke repo, dan JANGAN pernah log SMTP_PASSWORD.
# Port 465 = implicit SSL (default, mis. Hostinger smtp.hostinger.com);
# port 587 = STARTTLS. SMTP_FROM kosong = pengirim memakai SMTP_USER.
SMTP_ENABLED=false
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASSWORD=changeme
SMTP_FROM=
SMTP_FROM_NAME=THC VMS
SMTP_TIMEOUT=30s
