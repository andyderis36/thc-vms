# ============================================================
# THC Visitor Management System (VMS) - Backend Environment
# Salin file ini menjadi `.env` dan sesuaikan untuk lingkungan Anda.
# Nama variabel mengikuti docs/5. LOCAL_DEV.md bagian 4.1.
# Nilai pool database mengikuti docs/0. PRD bagian 6.1.2 (L200-203)
# dan docs/3. Arsitektur Auth bagian Persistence (L37).
# ============================================================

# --- App Configuration ---
APP_NAME=THC-VMS-Backend
APP_ENV=local
APP_PORT=8080
APP_DEBUG=true

# --- Database Connection (pgxpool) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=thc_user
DB_PASSWORD=thc_password_local
DB_NAME=thc_vms_db
DB_SSLMODE=disable
DB_MAX_CONNS=50
DB_MIN_CONNS=10
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=15m
DB_ACQUIRE_TIMEOUT=5s

# --- Authentication (JWT) ---
# WAJIB diisi. Backend menolak start bila kosong (tidak ada default aman).
# Nilai di bawah ini hanya contoh lokal yang JELAS PALSU — WAJIB diganti di
# production dengan string acak min. 32 karakter (mis. hasil `openssl rand -hex 32`).
JWT_SECRET=thc-super-secret-key-2026-mvp-token-signature
JWT_EXPIRATION_HOURS=24

# --- Login Anti-Bruteforce ---
# Batas upaya POST /auth/login per IP per jendela waktu.
# PERHATIAN: -1 = limiter DIMATIKAN (mode open, khusus local dev/QA saja).
# JANGAN pakai -1 di production! Produksi WAJIB 5 (default aman di bawah).
# Dev yang butuh login tanpa batas cukup set -1 di file `.env` lokalnya
# (gitignored) — jangan ubah default file ini.
AUTH_RATE_LIMIT=5
AUTH_RATE_WINDOW=1m

# --- CORS Tambahan (tunnel Cloudflare untuk demo remote) ---
# Daftar origin yang diizinkan selain default localhost:3210, koma-dipisah.
# Isi dengan URL tunnel FE (mis. https://xxx.trycloudflare.com) lalu restart BE.
# Kosongkan bila tak butuh akses remote.
CORS_ALLOWED_ORIGINS=

# --- S3 / MinIO Object Storage ---
# Kredensial di bawah ini HANYA untuk MinIO lokal via docker compose.
# WAJIB diganti (rotate) di production: isi dari secret manager / env server
# dengan kredensial S3/R2 asli, jangan pakai minioadmin.
STORAGE_DRIVER=minio
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=thc-vms-bucket
S3_USE_SSL=false
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=http://localhost:9000/thc-vms-bucket
# Masa berlaku URL bertanda tangan (presigned) untuk berkas pada respons
# GET /visits (menit). Bucket tetap privat; FE memakai URL singkat ini.
S3_PRESIGN_TTL_MINUTES=15

# --- File Upload Limits ---
MAX_UPLOAD_SIZE_MB=5
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png

# --- Auto-Rule Worker ---
# Periode sapuan aturan otomatis (cancel requested terlewat, flag overstay).
# Format durasi Go ("30m", "1h"). Kosong/rusak = default 1 jam.
WORKER_INTERVAL=30m
