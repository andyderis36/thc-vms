# Reverse proxy tunggal stack THC-VMS (Caddy).
# Satu origin untuk frontend + backend + object storage, sehingga frontend
# tidak perlu build ulang saat pindah dari IP LAN ke domain (atau sebaliknya).
#
#   /api/*  -> backend   (prefix DIJAGA; backend menyajikan route di /api/v1)
#   /s3/*   -> minio     (prefix DIPOTONG; bucket disajikan di root S3)
#   lainnya -> frontend  (Next.js standalone, :3210)
#
# Alamat site diambil dari env SITE_ADDRESS (diisi di .env VPS):
#   - kosong (default) -> ":80" catch-all HTTP, aman untuk akses LAN via IP.
#   - diisi domain      -> satu host dengan TLS otomatis (ACME) + redirect
#     HTTP->HTTPS. Syarat: DNS A/AAAA -> IP publik VPS, port 80 & 443 terbuka.
#     Tanpa IP publik, HTTP-01 tidak akan lolos, jadi biarkan default dulu.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	handle /api/* {
		# IP klien nyata hanya ada di X-Real-IP yang ditulis Traefik
		# (X-Forwarded-For dari Traefik tidak konsisten: mayoritas berisi IP
		# Traefik sendiri — terbukti via capture + spoof-test: header palsu
		# dari luar selalu ditimpa Traefik, jadi nilai yang tiba di sini
		# tepercaya HANYA bila peer langsung adalah Traefik).
		# Aturan di bawah bersifat deny-by-default: koneksi langsung (peer
		# bukan Traefik) mendapat XFF = IP peer-nya sendiri dan X-Real-IP
		# dibuang, sehingga header palsu tak pernah sampai ke backend.
		@viaTraefik remote_ip 58.147.187.14/32
		handle @viaTraefik {
			reverse_proxy backend:8080 {
				header_up X-Forwarded-For {http.request.header.X-Real-Ip}
			}
		}
		handle {
			reverse_proxy backend:8080 {
				header_up -X-Real-IP
			}
		}
	}

	handle_path /s3/* {
		reverse_proxy minio:9000
	}

	handle {
		reverse_proxy frontend:3210
	}
}
