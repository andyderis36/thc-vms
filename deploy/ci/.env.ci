# deploy/ci/.env.ci - nilai DUMMY untuk CI. Jangan pernah diisi kredensial nyata.
# Dibaca oleh migrate, seed, dan backend lewat `env_file`. Nama variabel
# mengikuti backend/internal/config/config.go.

# --- Postgres (harus sama dengan environment service postgres) ---
POSTGRES_USER=thc_user
POSTGRES_PASSWORD=thc_password_local
POSTGRES_DB=thc_vms_db

# --- App ---
APP_NAME=THC-VMS-Backend
# `local` mematikan guard produksi dan membiarkan auto-migrate saat boot
# (idempotent, sudah dijalankan eksplisit oleh service migrate).
APP_ENV=local
APP_DEBUG=true
APP_PORT=8080

# --- Database ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=thc_user
DB_PASSWORD=thc_password_local
DB_NAME=thc_vms_db
DB_SSLMODE=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_MIN_IDLE_CONNS=1

# --- Auth ---
# Dummy. Panjang, tetapi jelas bukan rahasia produksi.
JWT_SECRET=ci-dummy-jwt-secret-00000000000000000000000000000000
JWT_EXPIRATION_HOURS=24
# -1 = limiter mati. Hanya boleh di CI/dev.
AUTH_RATE_LIMIT=-1
AUTH_RATE_WINDOW=1m
CORS_ALLOWED_ORIGINS=http://127.0.0.1:13210

# --- Object storage (nama S3_*, bukan MINIO_*) ---
STORAGE_DRIVER=minio
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY_ID=thc_minio_ci
S3_SECRET_ACCESS_KEY=thc_minio_password_ci
S3_BUCKET_NAME=thc-vms-bucket
S3_USE_SSL=false
S3_REGION=us-east-1
# Hanya memengaruhi URL yang DISIMPAN (FileURL), bukan host presigned URL.
S3_PUBLIC_BASE_URL=http://127.0.0.1:19000/thc-vms-bucket
S3_PRESIGN_TTL_MINUTES=15

# --- Upload policy ---
MAX_UPLOAD_SIZE_MB=5
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png
WORKER_INTERVAL=15m

# --- MinIO server (dipakai juga sebagai kredensial S3 di atas) ---
MINIO_ROOT_USER=thc_minio_ci
MINIO_ROOT_PASSWORD=thc_minio_password_ci

# --- Bootstrap ---
# Tidak dipakai compose CI: seed dijalankan sebagai service tersendiri.
# Dipertahankan 0 supaya file ini tidak pernah memicu seed destruktif.
BOOTSTRAP_SEED=0
