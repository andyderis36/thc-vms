flowchart TD
    Start([PIC atau Admin Buka Detail Kunjungan]) --> TombolReschedule[Klik Tombol Reschedule]
    TombolReschedule --> ModalInput[Modal: Pilih Rentang Tanggal Baru & Alasan]
    ModalInput --> ValidasiTanggal{Tanggal Valid?}
    
    ValidasiTanggal -- Tidak (Masa Lalu / Melebihi Batas) --> ModalInput
    ValidasiTanggal -- Ya --> SubmitReschedule[Kirim Pengajuan Reschedule]
    
    SubmitReschedule --> UpdateStatusRescheduled[Update Status: rescheduled]
    UpdateStatusRescheduled --> LogStatus[Catat Riwayat Perubahan Status]
    LogStatus --> AdminReview[Admin THC Meninjau Jadwal Baru]
    
    AdminReview --> Keputusan{Keputusan Admin}
    Keputusan -- Setujui Jadwal Baru --> StatusApproved[Status Kembali: approved]
    Keputusan -- Tolak Perubahan --> StatusCancelled[Status: cancelled]
    
    StatusApproved --> Selesai([Selesai: Terbit QR Code Baru])
    StatusCancelled --> Selesai