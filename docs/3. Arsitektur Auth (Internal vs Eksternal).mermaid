flowchart TD
    subgraph Client["Frontend Client (Next.js 16.3+ / React 19.3)"]
        UI1["SCR-01: Login Terpadu (Superadmin, Admin, Security, Vendor)"]
        UI2["Role & Branch Route Guards (Context: role & location_id)"]
        UI3["TanStack Query (Client-Side Caching & Scoped Queries)"]
        UI1 --> UI2 --> UI3
    end

    subgraph AuthLayer["Auth & Middleware Layer (Go Gin)"]
        MW1["Rate Limiter (Anti-Bruteforce Guard)"]
        MW2["JWT Authenticator (Claims: sub, role, location_id, location_name) + per-request scope stash (thc.scope)"]
        MW3["RBAC & Multi-Branch Scope Enforcer"]
        
        subgraph PolicyRules["Scope Isolation Rules"]
            R1["Superadmin: Bypass Location Filter (Global Control) — is_global=true (nasional) atau menyempit ke satu cabang"]
            R2["Admin/Koordinator: Scoped to user_locations union (location_id = ANY(location_ids)) + EXISTS untuk users/notifikasi"]
            R3["Security: Scoped to user_locations union (Gate Ops & Check-in Only)"]
            R4["Vendor: Scoped to vendor_user_id == user.id (owner-path, tidak terpengaruh multi-branch)"]
            R5["Multi-branch guard: resolver AccessibleLocationIDs membaca user_locations per request; union kosong + is_global=false = fail-closed"]
        end
        
        subgraph ScopeResolver["Per-Request Scope Resolver"]
            SR1["ScopeStore.ListUserLocationIDs (user_locations)"]
            SR2["AccessibleLocationIDs (super_admin/vendor short-circuit; branch-bound resolve union)"]
            SR3["WithScope -> thc.scope stash (LocationIDs, IsGlobal)"]
            SR1 --> SR2 --> SR3
        end

        subgraph Adapters["Modular Auth Adapter (KISS & Extensible)"]
            A1["[MVP ACTIVE] PasswordAuthAdapter (Email + Bcrypt Hash)"]
            A2["[Phase 2 Ready] SSOAuthAdapter (THC IdP / OIDC)"]
            A3["[Phase 2 Ready] OTPAuthAdapter (Email / WA Gateway)"]
        end
    end

    subgraph CoreServices["Backend Clean Architecture (Go Gin Services)"]
        S1["Auth & Session Service"]
        S2["Visit & Approval Service (Branch-Scoped)"]
        S3["Security Check-in & Gate Service (Branch-Scoped)"]
        S4["Branch Security User Management Service"]
        S5["Media & Storage Service (minio-go/v7)"]
    end

    subgraph Persistence["Persistence & Object Storage Layer"]
        POOL["pgxpool Connection Pool (MaxConns: 50, Timeout: 5s)"]
        PG[("PostgreSQL 18.6 (Indexed B-Tree)") ]
        MINIO[("MinIO / AWS S3 (Surat Tugas, KTP, Foto)") ]
        POOL --> PG
    end

    UI3 -- "HTTPS REST Request (Bearer JWT)" --> MW1
    MW1 --> MW2 --> MW3
    MW2 -.-> ScopeResolver
    MW3 -.-> PolicyRules
    MW3 -.-> ScopeResolver
    MW3 --> Adapters
    Adapters --> S1
    MW3 --> S2
    MW3 --> S3
    MW3 --> S4
    MW3 --> S5
    
    S1 --> POOL
    S2 --> POOL
    S3 --> POOL
    S4 --> POOL
    S5 --> MINIO