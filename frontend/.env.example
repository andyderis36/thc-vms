# Copy to .env.local and adjust for your machine.

# Base URL of the Go backend REST API (docs/4. openapi.yaml)
NEXT_PUBLIC_API_BASE_URL="http://localhost:8080/api/v1"

# MinIO / S3 public base URL for Surat Tugas, KTP photos, check-in photos
NEXT_PUBLIC_STORAGE_BASE_URL="http://localhost:9000/thc-vms-bucket"

NEXT_PUBLIC_APP_NAME="THC Visitor Management System"

# Dev-only MSW mock switch ("enabled" | "disabled").
# Set to "disabled" once the Go backend is running — the frontend then calls the real API.
NEXT_PUBLIC_API_MOCKING="enabled"
