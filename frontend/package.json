{
  "name": "thc-vms-frontend",
  "version": "3.1.0",
  "private": true,
  "description": "THC Visitor Management System (VMS) - ISP Edition. Frontend Next.js 16 App Router.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev -p 3210",
    "build": "next build",
    "start": "next start -p 3210",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-query": "5.103.2",
    "html5-qrcode": "2.3.8",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-easy-crop": "6.2.4",
    "react-hook-form": "^7.88.0",
    "react-qr-code": "^2.2.0",
    "sonner": "^2.0.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.3.6",
    "jsdom": "^25.0.1",
    "minio": "^8.0.7",
    "msw": "^2.15.0",
    "postcss": "^8.4.49",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
